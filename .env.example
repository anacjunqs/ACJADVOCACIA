# ─────────────────────────────────────────────────────────────────────────────
# ACJ Advocacia — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings → Environment Variables).
# O site compila e roda SEM nenhuma destas variáveis, usando o conteúdo de /content/seed.
# Variáveis NEXT_PUBLIC_* são embutidas no build: mudar o valor exige novo deploy.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br
# Enquanto "false", todas as páginas saem com noindex e o robots.txt bloqueia a indexação.
# Só mude para "true" no lançamento, depois de resolver todas as pendências ([PREENCHER] e [REVISAR]).
NEXT_PUBLIC_SITE_INDEXABLE=false
# Exibe os artigos/vídeo de exemplo (rascunhos do seed). Padrão: ligado fora de produção.
SHOW_SEED_DRAFTS=

# CMS (Sanity). Sem estas variáveis o site usa /content/seed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Token de leitura (perfil Viewer): permite pré-visualizar rascunhos no Studio (ferramenta "Presentation").
# Somente servidor; nunca use o prefixo NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Token de escrita: usado apenas localmente por `npm run seed:sanity`. NUNCA cadastrar na Vercel.
SANITY_API_WRITE_TOKEN=
# Segredo do webhook do Sanity → /api/revalidate (assinatura HMAC).
SANITY_REVALIDATE_SECRET=

# Formulário de contato (Resend)
RESEND_API_KEY=
# Remetente em domínio verificado no Resend. Ex.: "ACJ Advocacia <contato@seudominio.com.br>"
CONTACT_FROM_EMAIL=
# Quem recebe as mensagens (não é exibido no site).
CONTACT_TO_EMAIL=
# Segredo para assinar o token de tempo mínimo de preenchimento (gere com: openssl rand -hex 32).
CONTACT_FORM_SECRET=

# Depoimentos (avaliações do Google). Mantenha "false" até a confirmação escrita da advogada.
NEXT_PUBLIC_ENABLE_TESTIMONIALS=false
# Somente servidor. Restrinja a chave à Places API (New) e ao IP/servidor.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Opcionais: substituem os links derivados do Place ID.
GOOGLE_REVIEWS_URL_OVERRIDE=
GOOGLE_WRITE_REVIEW_URL_OVERRIDE=

# Estatísticas (carregam somente após consentimento). none | plausible | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# Mapa incorporado (Google Maps Embed API; carrega somente após consentimento).
# Sem chave, a página de contato mostra apenas o link "Abrir no mapa".
NEXT_PUBLIC_MAPS_EMBED_KEY=
